{
  // Indique à Renovate quel schéma JSON utiliser
  // Cela permet la validation du fichier et l’autocomplétion dans les éditeurs
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  
  //Activation de Renovate Dashboard,
  "enabled": true,
  
  // Fuseau horaire utilisé par Renovate
  "timezone": "Europe/Paris",

  // Renovate ne crée les PR que pendant cette plage horaire
  "schedule": ["before 06:00 AM"],

  // Configurations héritées
  "extends": [
    "config:recommended",
    "github>Nicoyong/TalosCluster//.github/renovate/kinds.json5",
    "github>Nicoyong/TalosCluster//.github/renovate/special_talos.json5",
    "github>Nicoyong/TalosCluster//.github/renovate/special_longhorn.json5",
    "github>Nicoyong/TalosCluster//.github/renovate/major_dashboardapproval_disable.json5"

    // Désactive le pinning digest pour Helm et Flux
    //"github>Nicoyong/TalosCluster//.github/renovate/special_stopdigistpinning.json5"
  ],

  // Automerge PATCH uniquement pour les applications déployées dans apps/
  // Les composants d’infrastructure restent soumis à une validation manuelle.
  "packageRules": [
    {
      "description": "Automerge des mises à jour PATCH des applications uniquement",
      "matchFileNames": ["clusters/main/kubernetes/apps/**"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr",
      // Le workflow GitHub exige ce label pour autoriser la fusion.
      "labels": ["renovate", "automerge"]
    }
  ],

  // Active le Renovate Dashboard
  "dependencyDashboard": true,

  // Label par défaut des PR Renovate
  "labels": ["renovate"],
  
  // Rebase uniquement en cas de conflit
  "rebaseWhen": "conflicted",
  
  // Limites de création des PR
  "prHourlyLimit": 5,
  "prConcurrentLimit": 10
}
